# ---------------------------------------------------
# Bappa's Arena - Environment Configuration
# Copy this file to ".env" and fill in your own values
# ---------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bappas-arena?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# JWT secret used to sign admin login tokens (use a long random string)
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Default admin account (auto-created the first time the server starts
# if no admin exists yet in the database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# Current active festival year shown by default across the site
CURRENT_FESTIVAL_YEAR=2026
